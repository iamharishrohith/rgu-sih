<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>200+ Unique, Stylish Team Names for Hackathons</title>
<style>
  body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; margin: 30px auto; max-width: 950px; color: #1e293b; background: #ffffff; }
  h1 { color: #0f2c59; font-size: 24px; margin-bottom: 4px; }
  p.sub { font-size: 13px; color: #64748b; margin-bottom: 24px; }
  .badge-bar { display: flex; gap: 12px; margin-bottom: 25px; }
  .badge { background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px 14px; flex: 1; text-align: center; }
  .badge-num { font-size: 20px; font-weight: bold; color: #2563eb; }
  .badge-lbl { font-size: 11px; text-transform: uppercase; color: #475569; font-weight: 600; }
  h2 { font-size: 17px; color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; margin-top: 30px; }
  p.cat-desc { font-size: 12px; font-style: italic; color: #64748b; margin-top: -4px; margin-bottom: 12px; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px; }
  th { background: #f8fafc; color: #334155; font-weight: bold; border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; }
  td { border: 1px solid #e2e8f0; padding: 7px 10px; vertical-align: middle; }
  tr:nth-child(even) { background: #fbfcfd; }
  .name-col { font-weight: bold; color: #1d4ed8; font-size: 14px; }
  .center { text-align: center; width: 40px; }
  @media print {
    body { margin: 12mm; }
    h2 { page-break-after: avoid; }
    table { page-break-inside: auto; }
    tr { page-break-inside: avoid; page-break-after: auto; }
  }
</style>
</head>
